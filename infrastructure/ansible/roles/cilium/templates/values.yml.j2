{% if cilium_network_mode == 'vxlan' %}
# Encapsulated baseline: Pod traffic between nodes uses a VXLAN overlay.
routingMode: tunnel
tunnelProtocol: vxlan
tunnelPort: 8472
autoDirectNodeRoutes: false
{% else %}
# Flat profile: pass each Kubernetes-assigned PodCIDR through the host routing
# stack and install a direct route through the owning node on the shared L2.
routingMode: native
ipv4NativeRoutingCIDR: {{ kubernetes_pod_subnet }}
autoDirectNodeRoutes: {{ 'false' if cilium_network_mode in cilium_vm_vxlan_modes else 'true' }}
{% endif %}
devices: {{ 'experiment,cs740vx' if cilium_network_mode in cilium_vm_vxlan_modes else 'experiment' }}
{% if cilium_network_mode == 'direct-1450' or cilium_network_mode in cilium_vm_vxlan_modes or cilium_network_mode in cilium_host_vxlan_modes %}
MTU: {{ cilium_inner_mtu }}
{% else %}
MTU: 0
{% endif %}

# Bootstrap directly through the control-plane address. During a datapath
# profile change, Cilium's service handling may be unavailable until the new
# agent starts, so using the kubernetes Service ClusterIP here can deadlock the
# rolling update.
k8sServiceHost: {{ hostvars[groups['kubernetes_controllers'][0]].kubernetes_node_ip }}
k8sServicePort: 6443

ipam:
  mode: kubernetes
k8s:
  requireIPv4PodCIDR: true

# Baseline retains kube-proxy. Explicit guest forwarding profiles share BPF
# service/masquerade prerequisites and differ only in hostLegacyRouting.
kubeProxyReplacement: {{ 'true' if cilium_forwarding_profile | default('baseline') != 'baseline' else 'false' }}
enableIPv4Masquerade: true
{% if cilium_forwarding_profile | default('baseline') != 'baseline' %}
# Both guest experiment profiles share prerequisites; only host routing differs.
bpf:
  masquerade: true
  hostLegacyRouting: {{ 'true' if cilium_forwarding_profile == 'bpf-legacy' else 'false' }}
{% endif %}

# A profile change updates cilium-config; roll the agents so that the new
# routing datapath takes effect during the same deployment.
rollOutCiliumPods: true

operator:
  replicas: 1

